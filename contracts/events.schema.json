{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zone event",
  "type": "object",
  "required": [
    "event_id", "device_id", "camera_id", "seq", "event_type",
    "zone_id", "object_type", "track_id", "source", "device_ts"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F-]{36}$" },
    "device_id": { "type": "string", "minLength": 1 },
    "camera_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "event_type": { "enum": ["enter", "exit"] },
    "zone_id": { "type": "string", "minLength": 1 },
    "object_type": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "track_id": { "type": "integer" },
    "config_version": { "type": "integer", "minimum": 1 },
    "source": { "enum": ["model", "mock"] },
    "device_ts": { "type": "string", "format": "date-time" }
  }
}
