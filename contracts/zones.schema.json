{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Camera zone configuration",
  "type": "object",
  "required": ["camera_id", "image_size", "zones"],
  "additionalProperties": false,
  "properties": {
    "camera_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "reference_frame": { "type": "string" },
    "image_size": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "polygon"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "min_dwell_s": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
